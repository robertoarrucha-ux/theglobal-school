---
import '../styles/marketplace.css';
import { LANG, SELF_ORIGIN, OTHER_ORIGIN, UI } from '../lib/site';

interface Props { title: string; description?: string; canonical?: string; ogImage?: string; }
const { title, description = '', canonical = '', ogImage = '' } = Astro.props;
const L = LANG === 'es';
const canonicalUrl = canonical || SELF_ORIGIN[LANG] + Astro.url.pathname;
const ogFull = ogImage ? new URL(ogImage, Astro.site).href : '';
---
<!doctype html>
<html lang={LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {ogFull && <meta property="og:image" content={ogFull} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#07000f" />
  </head>
  <body class="mkt">
    <header class="mkt-header">
      <div class="inner">
        <a href="/" class="mkt-brand" aria-label="The New Global School">
          <img src="/favicon-192.png" alt="" width="192" height="192" />
          <span>The <b>New Global</b> School</span>
        </a>
        <button class="mkt-burger" type="button" aria-label="Menú" aria-expanded="false" aria-controls="mkt-nav"><span></span><span></span><span></span></button>
        <nav class="mkt-nav" id="mkt-nav">
          <a href={L ? '/experiencias/' : '/experiences/'}>{L ? 'Experiencias' : 'Experiences'}</a>
          <a href="/blog/">Blog</a>
          <a href={L ? '/nosotros/' : '/about-us/'}>{L ? 'Nosotros' : 'About'}</a>
          <a href={OTHER_ORIGIN[LANG] + '/'}>{UI[LANG].langSwitch}</a>
          <a class="to-site" href="https://aliados.theglobal.school/">{L ? 'Únete como aliado' : 'Become an ally'}</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <script is:inline>
      // Menú móvil: el botón hamburguesa abre/cierra la navegación.
      (function () {
        var b = document.querySelector('.mkt-burger'), n = document.getElementById('mkt-nav');
        if (!b || !n) return;
        b.addEventListener('click', function () {
          var open = n.classList.toggle('open');
          b.classList.toggle('open', open);
          b.setAttribute('aria-expanded', String(open));
        });
        // Cerrar al tocar un enlace
        n.addEventListener('click', function (e) {
          if (e.target.closest('a')) { n.classList.remove('open'); b.classList.remove('open'); b.setAttribute('aria-expanded', 'false'); }
        });
      })();
    </script>
    <script is:inline>
      // Lite-YouTube: carga el iframe real solo al hacer clic (primer render sin YouTube).
      (function () {
        document.querySelectorAll('.lite-yt').forEach(function (el) {
          el.addEventListener('click', function () {
            var id = el.getAttribute('data-id');
            if (!id) return;
            var f = document.createElement('iframe');
            f.className = 'lite-yt-frame';
            f.src = 'https://www.youtube.com/embed/' + id + '?autoplay=1&rel=0';
            f.title = 'Video';
            f.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
            f.setAttribute('allowfullscreen', '');
            el.replaceChildren(f);
          }, { once: true });
        });
      })();
    </script>
    <script is:inline>
      // Oculta imágenes rotas para revelar el gradiente de marca (fallback elegante).
      document.addEventListener('error', (e) => {
        const t = e.target;
        if (t && t.tagName === 'IMG') t.style.display = 'none';
      }, true);
    </script>
    <script is:inline>
      // Slideshow: auto-avance suave del carrusel de galería (pausa al interactuar).
      // Expuesto en window para re-inicializar tras el "freshen" (cuando se reemplaza la galería).
      window.__tngsInitGallery = function () {
        var strip = document.querySelector('.gallery-strip[data-autoplay]');
        if (!strip || strip.children.length < 2 || strip.__tngsInit) return;
        strip.__tngsInit = true;
        var paused = false, i = 0;
        ['pointerdown', 'mouseenter', 'touchstart'].forEach(function (e) { strip.addEventListener(e, function () { paused = true; }, { passive: true }); });
        strip.addEventListener('mouseleave', function () { paused = false; });
        setInterval(function () {
          if (paused) return;
          i = (i + 1) % strip.children.length;
          var el = strip.children[i];
          strip.scrollTo({ left: el.offsetLeft - (strip.offsetWidth - el.offsetWidth) / 2, behavior: 'smooth' });
        }, 4500);
      };
      window.__tngsInitGallery();
    </script>
    <script is:inline>
      // Actualización en vivo: la página estática se refresca desde Firestore al cargar,
      // así los visitantes ven publicaciones/ediciones en segundos, sin esperar el rebuild.
      // El endpoint devuelve fragmentos HTML ya renderizados (una sola fuente de render).
      (function () {
        if (!document.querySelector('[data-fresh="title"]')) return; // solo páginas de detalle
        var parts = location.pathname.replace(/\/+$/, '').split('/');
        var slug = parts[parts.length - 1];
        if (!slug) return;
        var lang = document.documentElement.lang === 'es' ? 'es' : 'en';
        fetch('/api/experience?slug=' + encodeURIComponent(slug) + '&lang=' + lang, { headers: { Accept: 'application/json' } })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (j) {
            if (!j || !j.html) return;
            var h = j.html;
            setText('[data-fresh="title"]', h.title);
            setText('[data-fresh="summary"]', h.summary);
            setHtml('[data-fresh="meta"]', h.meta);
            setHtml('[data-fresh="price"]', h.price);
            setHtml('[data-fresh="highlights"]', h.highlights);
            block('[data-fresh="sections"]', h.sections, function (has) {
              var fb = document.querySelector('[data-fresh-fallback]');
              if (fb) fb.hidden = has; // oculta el contenido migrado si ahora hay secciones
            });
            block('[data-fresh="collaborators"]', h.collaborators);
            block('[data-fresh="gallery"]', h.gallery, function () { if (window.__tngsInitGallery) window.__tngsInitGallery(); });
            block('[data-fresh="testimonials"]', h.testimonials);
            block('[data-fresh="inclusions"]', h.inclusions);
          })
          .catch(function () {});
        function setText(sel, val) { var e = document.querySelector(sel); if (e && val != null && e.textContent !== val) e.textContent = val; }
        function setHtml(sel, val) { var e = document.querySelector(sel); if (e && val != null) e.innerHTML = val; }
        function block(sel, val, cb) { var e = document.querySelector(sel); if (!e) return; var has = !!(val && val.trim()); e.innerHTML = has ? val : ''; e.hidden = !has; if (cb) cb(has); }
      })();
    </script>
    <script is:inline>
      // Widget de votación en páginas de detalle de viaje (.xp-vote[data-slug]).
      (function () {
        var box = document.querySelector('.xp-vote[data-slug]');
        if (!box) return;
        var slug = box.getAttribute('data-slug');
        var es = document.documentElement.lang === 'es';
        var votedTxt = es ? 'Votado ✓' : 'Voted ✓';
        var countEl = box.querySelector('.xp-vote-count');
        var btn = box.querySelector('.xp-vote-btn');
        fetch('/api/votes').then(function (r) { return r.json(); }).then(function (j) {
          countEl.textContent = (j.counts && j.counts[slug]) || 0;
          if (j.voted && j.voted.indexOf(slug) !== -1) { btn.disabled = true; btn.textContent = votedTxt; }
        }).catch(function () { countEl.textContent = '0'; });
        btn.addEventListener('click', function () {
          btn.disabled = true;
          fetch('/api/votes', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ slug: slug }) })
            .then(function (r) { return r.json(); }).then(function (j) {
              if (j.votes != null) countEl.textContent = j.votes;
              btn.textContent = votedTxt;
            }).catch(function () { btn.disabled = false; });
        });
      })();
    </script>
    <footer class="mkt-header" style="position:static;border-top:1px solid var(--line);border-bottom:0;margin-top:2rem">
      <div class="inner site-legal" style="color:var(--txt-soft);font-size:.82rem;flex-wrap:wrap;gap:.4rem 1.2rem">
        <span>© {new Date().getFullYear()} Global School. Lindengasse 56, 1070 {L ? 'Viena' : 'Vienna'}, Austria. {L ? 'Todos los derechos reservados.' : 'All rights reserved.'} {L ? 'Consulta aquí nuestras políticas de' : 'Check here our'} <a href={L ? '/politicas/#impressum' : '/terms/#impressum'}>IMPRESSUM</a>, <a href={L ? '/politicas/#privacidad' : '/terms/#privacy'}>{L ? 'PRIVACIDAD' : 'PRIVACY'}</a> {L ? 'y' : '&'} <a href={L ? '/politicas/#terminos' : '/terms/#terms'}>{L ? 'TÉRMINOS DE USO' : 'TERMS OF USE'}</a>.</span>
        <a class="to-site" href="/">{L ? 'Volver al sitio' : 'Back to main site'}</a>
      </div>
    </footer>
  </body>
</html>
