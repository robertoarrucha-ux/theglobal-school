---
// Prueba social para fichas que todavía no tienen testimonios propios.
// Se etiqueta explícitamente como testimonios de OTROS programas de la escuela, para que
// nadie los lea como opiniones sobre este viaje concreto. En EN se marca que son traducidos.
import { LANG } from '../lib/site';
import { PROOF_QUOTES, PROOF_LOGOS } from '../data/social-proof';
const L = LANG === 'es';
---
<section class="proof">
  <header class="proof-head">
    <h2>{L ? 'Quién está detrás de este programa' : 'Who runs this program'}</h2>
    <p>
      {L
        ? 'Este itinerario es nuevo, nuestra experiencia no. Estos son testimonios de participantes de nuestros programas ejecutivos en Viena.'
        : 'This itinerary is new, our track record is not. These are testimonials from participants in our executive programs in Vienna, translated from Spanish.'}
    </p>
  </header>

  <div class="proof-quotes">
    {PROOF_QUOTES.map((q) => (
      <figure class="proof-quote glass">
        <blockquote>{L ? q.quote : q.quoteEn}</blockquote>
        <figcaption>
          <img src={q.photo} alt="" width="44" height="44" loading="lazy" decoding="async" />
          <span>
            <strong>{q.author}</strong>
            <em>{L ? q.org : q.orgEn}</em>
          </span>
        </figcaption>
      </figure>
    ))}
  </div>

  <p class="proof-logos-label">
    {L ? 'Instituciones y organizaciones con las que hemos trabajado' : 'Institutions and organizations we have worked with'}
  </p>
  <div class="proof-logos">
    {PROOF_LOGOS.map((l) => (
      <div class="logo-tile" title={l.name}>
        <img src={l.src} alt={l.name} loading="lazy" decoding="async" />
      </div>
    ))}
  </div>
</section>

<style>
  .proof { margin: 3rem 0 0; }
  .proof-head { margin-bottom: 1.6rem; }
  .proof-head h2 { font-size: clamp(1.4rem, 3vw, 1.9rem); margin: 0 0 0.5rem; }
  .proof-head p { color: var(--txt-soft); margin: 0; max-width: 62ch; line-height: 1.6; font-size: 0.95rem; }

  .proof-quotes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .proof-quote { margin: 0; padding: 1.4rem; border-radius: 16px; display: flex; flex-direction: column; gap: 1.1rem; }
  .proof-quote blockquote {
    margin: 0; flex: 1; font-size: 0.95rem; line-height: 1.6; color: var(--txt);
    position: relative; padding-top: 1.6rem;
  }
  .proof-quote blockquote::before {
    content: '“'; position: absolute; top: -0.6rem; left: -0.2rem;
    font-family: Georgia, serif; font-size: 3.4rem; line-height: 1; color: var(--purple-bright); opacity: 0.4;
  }
  .proof-quote figcaption { display: flex; align-items: center; gap: 0.7rem; }
  .proof-quote figcaption img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .proof-quote figcaption span { display: grid; gap: 0.1rem; min-width: 0; }
  .proof-quote figcaption strong { font-size: 0.9rem; font-weight: 700; }
  .proof-quote figcaption em { font-style: normal; font-size: 0.76rem; line-height: 1.3; color: var(--txt-soft); }

  .proof-logos-label {
    margin: 2.4rem 0 1rem; text-align: center; font-size: 0.72rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--txt-soft);
  }
  /* Mismo tratamiento que la página institucional: ficha blanca, logo en su color real.
     Pintarlos de blanco plano aplasta los logos multicolor y los deja ilegibles. */
  .proof-logos { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.7rem; }
  .proof-logos :global(.logo-tile) { width: 148px; min-height: 76px; padding: 0.9rem 1rem; }
  .proof-logos :global(.logo-tile img) { max-height: 44px; }

  @media (max-width: 860px) { .proof-quotes { grid-template-columns: 1fr; } }
</style>
