---
// Contenido de la ficha imprimible. Se alimenta del mismo doc de Firestore que la
// página del viaje, así que no hay una segunda fuente de verdad que mantener.
import QRCode from 'qrcode';
import { LANG, SELF_ORIGIN, BRAND } from '../lib/site';
import { getInclusions } from '../lib/inclusions';
import { editionRows } from '../lib/editions';
import { PROOF_STATS, PROOF_LOGOS } from '../data/social-proof';

const { x } = Astro.props as any;
const L = LANG === 'es';
const t = L
  ? { brief: 'Ficha de programa', dest: 'Destinos', dur: 'Duración', days: 'días', dates: 'Fechas 2027',
      lang: 'Idioma', group: 'Grupo', groupMax: 'máx.', people: 'participantes', fmt: 'Formato',
      why: 'Por qué este viaje', importance: 'Relevancia', learning: 'Aprendizaje', today: 'Hoy',
      itin: 'Itinerario', day: 'Día', incl: 'Incluye', notIncl: 'No incluye',
      who: 'Quién lo opera', contact: 'Organiza tu grupo', scan: 'Escanea para ver el programa completo',
      cta: 'Preparamos una propuesta a la medida: fechas, idioma, tamaño de grupo e itinerario.',
      partners: 'Instituciones con las que hemos trabajado', priceNote: 'Precio a consultar según grupo y fechas' }
  : { brief: 'Program brief', dest: 'Destinations', dur: 'Duration', days: 'days', dates: 'Dates 2027',
      lang: 'Language', group: 'Group', groupMax: 'max.', people: 'participants', fmt: 'Format',
      why: 'Why this journey', importance: 'Relevance', learning: 'Learning', today: 'Today',
      itin: 'Itinerary', day: 'Day', incl: 'Included', notIncl: 'Not included',
      who: 'Who runs it', contact: 'Organize your group', scan: 'Scan to see the full program',
      cta: 'We prepare a tailored proposal: dates, language, group size and itinerary.',
      partners: 'Institutions we have worked with', priceNote: 'Price on request, depending on group and dates' };

const tripPath = L ? `/experiencias/${x.slug}/` : `/experiences/${x.slug}/`;
const tripUrl = `${SELF_ORIGIN[LANG]}${tripPath}`;
// El QR lleva a la ficha web, no a esta hoja: quien lo escanee en papel aterriza en
// la página que tiene el CTA de propuesta, y el interés queda como lead rastreable.
const qrSvg = await QRCode.toString(tripUrl, {
  type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#241633', light: '#0000' },
});

const inc = getInclusions(LANG);
const included = x.included?.length ? x.included : (x.type === 'viaje' ? inc.included : []);
const notIncluded = x.notIncluded?.length ? x.notIncluded : (x.type === 'viaje' ? inc.notIncluded : []);
const rows = editionRows(x, L);
const cities: string[] = x.cities?.length ? x.cities : [x.city].filter(Boolean);
const fmtLabel = (f: string) =>
  L ? ({ presencial: 'Presencial', online: 'Online', hibrido: 'Híbrido' } as any)[f] || 'Presencial'
    : ({ presencial: 'In person', online: 'Online', hibrido: 'Hybrid' } as any)[f] || 'In person';
const itinerary = x.itinerary || [];
---
<header class="op-head">
  <div class="op-brand">
    <img src="/media/2026/01/logo-tngs-dark.webp" alt={BRAND} width="1076" height="338" />
  </div>
  <span class="op-kicker">{t.brief}</span>
</header>

<section class="op-hero avoid-break">
  <img class="op-cover" src={x.coverImageUrl} alt="" />
  <h1>{x.title}</h1>
  <p class="op-summary">{x.summary}</p>
</section>

<section class="op-facts avoid-break">
  <div><dt>{t.dest}</dt><dd>{cities.join(' · ')}</dd></div>
  {x.durationDays && <div><dt>{t.dur}</dt><dd>{x.durationDays} {t.days}</dd></div>}
  {rows.length > 0 && <div><dt>{t.dates}</dt><dd>{rows.map((r) => <span class="op-edition">{r.label}: {r.range}</span>)}</dd></div>}
  <div><dt>{t.lang}</dt><dd>{x.language}</dd></div>
  {x.capacity && <div><dt>{t.group}</dt><dd>{t.groupMax} {x.capacity} {t.people}</dd></div>}
  <div><dt>{t.fmt}</dt><dd>{fmtLabel(x.format)}</dd></div>
</section>

{x.rationale && (
  <section class="op-block avoid-break">
    <h2>{t.why}</h2>
    <div class="op-why">
      <div><h3>{t.importance}</h3><p>{x.rationale.importance}</p></div>
      <div><h3>{t.learning}</h3><p>{x.rationale.learning}</p></div>
      <div><h3>{t.today}</h3><p>{x.rationale.relevance}</p></div>
    </div>
  </section>
)}

{(included.length > 0 || notIncluded.length > 0) && (
  <section class="op-block avoid-break">
    <div class="op-incl">
      {included.length > 0 && (
        <div><h3 class="op-yes">{t.incl}</h3><ul>{included.map((i: string) => <li>{i}</li>)}</ul></div>
      )}
      {notIncluded.length > 0 && (
        <div><h3 class="op-no">{t.notIncl}</h3><ul>{notIncluded.map((i: string) => <li>{i}</li>)}</ul></div>
      )}
    </div>
  </section>
)}

<section class="op-block avoid-break">
  <h2>{t.who}</h2>
  <div class="op-stats">
    {PROOF_STATS.map((s) => <div><strong>{s.value}</strong><span>{L ? s.es : s.en}</span></div>)}
  </div>
  <p class="op-logos-label">{t.partners}</p>
  <div class="op-logos">
    {PROOF_LOGOS.map((l) => <div><img src={l.src} alt={l.name} /></div>)}
  </div>
</section>

{itinerary.length > 0 && (
  <section class="op-block">
    <h2 class="keep-next">{t.itin}</h2>
    <ol class="op-itin">
      {itinerary.map((d: any) => (
        <li class="avoid-break">
          <strong><span class="op-day">{t.day} {d.day}</span> {d.title}</strong>
          {d.description && <p>{d.description}</p>}
        </li>
      ))}
    </ol>
  </section>
)}


<footer class="op-foot avoid-break">
  <div class="op-foot-text">
    <h2>{t.contact}</h2>
    <p>{t.cta}</p>
    <p class="op-contact">
      <strong>hello@theglobal.school</strong> · WhatsApp +43 677 6173 5010<br />
      Lindengasse 56, 1070 {L ? 'Viena' : 'Vienna'}, {L ? 'Austria' : 'Austria'}<br />
      <span class="op-url">{tripUrl.replace(/^https?:\/\//, '').replace(/\/$/, '')}</span> · <span class="op-price">{t.priceNote}</span>
    </p>
  </div>
  <div class="op-qr">
    <div class="op-qr-img" set:html={qrSvg} />
    <span>{t.scan}</span>
  </div>
</footer>

<style>
  h1, h2, h3 { font-family: 'Poppins', 'Inter', sans-serif; }

  .op-head {
    display: flex; align-items: center; justify-content: space-between;
    padding-bottom: 8pt; border-bottom: 2pt solid var(--ink); margin-bottom: 12pt;
  }
  .op-brand img { height: 30pt; width: auto; display: block; }
  .op-kicker {
    font-size: 7.5pt; letter-spacing: .18em; text-transform: uppercase;
    font-weight: 700; color: var(--purple);
  }

  .op-cover {
    width: 100%; height: 35mm; object-fit: cover; border-radius: 4pt; display: block; margin-bottom: 10pt;
  }
  .op-hero h1 { font-size: 19pt; line-height: 1.15; margin: 0 0 4pt; }
  .op-summary { margin: 0; font-size: 9.8pt; color: var(--ink-soft); line-height: 1.5; }

  .op-facts {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1pt;
    background: var(--rule); border: 1pt solid var(--rule); border-radius: 4pt;
    overflow: hidden; margin: 12pt 0;
  }
  .op-facts > div { background: var(--tint); padding: 7pt 9pt; }
  .op-facts dt {
    font-size: 7pt; letter-spacing: .12em; text-transform: uppercase;
    font-weight: 700; color: var(--purple); margin-bottom: 2pt;
  }
  .op-facts dd { margin: 0; font-size: 9.6pt; font-weight: 600; line-height: 1.35; }
  .op-edition { display: block; font-weight: 500; }

  .op-block { margin: 10pt 0; }
  .keep-next { break-after: avoid; page-break-after: avoid; }
  .op-block h2 {
    font-size: 12.5pt; margin: 0 0 8pt; padding-bottom: 3pt;
    border-bottom: 1pt solid var(--rule);
  }
  .op-why { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10pt; }
  .op-why h3 {
    font-size: 8pt; letter-spacing: .1em; text-transform: uppercase;
    color: var(--purple); margin: 0 0 3pt;
  }
  .op-why p { margin: 0; font-size: 8.7pt; line-height: 1.45; color: var(--ink-soft); }

  .op-incl { display: grid; grid-template-columns: 1fr 1fr; gap: 12pt; }
  .op-incl h3 { font-size: 9.5pt; margin: 0 0 4pt; }
  .op-yes { color: #1f7a4d; }
  .op-no { color: #a13d3d; }
  .op-incl ul { margin: 0; padding-left: 12pt; }
  .op-incl li { font-size: 8.5pt; line-height: 1.4; margin-bottom: 1.5pt; color: var(--ink-soft); }

  .op-itin { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: 14pt; }
  .op-itin li { break-inside: avoid; page-break-inside: avoid; padding: 0 0 4pt; margin-bottom: 4pt; border-bottom: 1pt solid var(--rule); }
  .op-itin li:last-child { border-bottom: 0; }
  .op-day {
    display: inline-block; font-size: 7pt; font-weight: 700; letter-spacing: .06em;
    text-transform: uppercase; color: #fff; background: var(--purple);
    border-radius: 2.5pt; padding: 1pt 4pt; margin-right: 3pt; vertical-align: 1.5pt;
  }
  .op-itin strong { font-size: 8.7pt; display: block; margin-bottom: 1pt; line-height: 1.3; }
  .op-itin p { margin: 0; font-size: 8.1pt; line-height: 1.32; color: var(--ink-soft); }

  .op-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8pt; margin-bottom: 10pt; }
  .op-stats > div {
    text-align: center; padding: 5.5pt 4pt; background: var(--tint);
    border: 1pt solid var(--rule); border-radius: 4pt;
  }
  .op-stats strong { display: block; font-size: 13.5pt; line-height: 1; color: var(--purple); font-weight: 700; }
  .op-stats span { font-size: 7.4pt; line-height: 1.25; color: var(--ink-soft); }
  .op-logos-label {
    margin: 0 0 5pt; font-size: 7pt; letter-spacing: .12em;
    text-transform: uppercase; color: var(--ink-soft);
  }
  /* 5 de los 9 logos institucionales vienen con fondo oscuro incrustado en el propio
     archivo. Una ficha uniforme los presenta como rejilla en lugar de bloques sueltos. */
  .op-logos { display: flex; flex-wrap: wrap; gap: 5pt; align-items: stretch; }
  .op-logos > div {
    width: 58pt; height: 26pt; display: grid; place-items: center; padding: 2pt 3pt;
    background: #fff; border: 0.75pt solid var(--rule); border-radius: 3pt;
  }
  .op-logos img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }

  .op-foot {
    display: flex; gap: 14pt; align-items: center; justify-content: space-between;
    margin-top: 11pt; padding: 8pt 11pt; background: var(--ink); color: #fff; border-radius: 5pt;
  }
  .op-foot h2 { font-size: 11pt; margin: 0 0 3pt; color: #fff; border: 0; padding: 0; }
  .op-foot p { margin: 0 0 3pt; font-size: 8.8pt; line-height: 1.42; color: #e0d8ee; }
  .op-contact strong { color: #fff; }
  .op-url { color: #c4a8ff; }
  .op-price { color: #b4a5cc; }
  .op-qr { flex: 0 0 62pt; text-align: center; }
  .op-qr-img { background: #fff; padding: 4pt; border-radius: 3pt; }
  .op-qr-img :global(svg) { width: 100%; height: auto; display: block; }
  .op-qr span { display: block; margin-top: 3pt; font-size: 6.2pt; line-height: 1.2; color: #b4a5cc; }

  @media print {
    .page-break { break-before: page; page-break-before: always; }
    .avoid-break { break-inside: avoid; page-break-inside: avoid; }
  }
</style>
