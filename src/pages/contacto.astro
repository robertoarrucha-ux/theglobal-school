---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { LANG } from '../lib/site';

// En el build EN esta ruta redirige a /contact/.
if (LANG === 'en') return Astro.redirect('/contact/');
---
<BaseLayout title="Contacto, The New Global School" description="Contáctanos, educación y eventos para líderes globales.">
  <article class="article page">
    <h1>Contacto</h1>
    <p>Cuéntanos sobre tu proyecto, programa o evento. Solemos responder en un día hábil.</p>
    <LeadForm />
  </article>
</BaseLayout>
