---
import MarketplaceLayout from '../layouts/MarketplaceLayout.astro';
import { getCollection } from 'astro:content';
import { loadExperiences } from '../lib/experiences';
import { seasonsText } from '../lib/editions';
import { LANG, BRAND, SELF_ORIGIN } from '../lib/site';

const L = LANG === 'es';
const xbase = L ? '/experiencias' : '/experiences';
const applyUrl = 'https://aliados.theglobal.school/'; // landing de aliados (explica el programa + beneficios)

const experiences = await loadExperiences();
// Datos para el widget de votación (solo viajes/expediciones).
const votingData = experiences
  .filter((x: any) => x.type === 'viaje')
  .map((x: any) => ({ slug: x.slug, title: x.title, cover: x.coverImageUrl, url: `${LANG === 'es' ? '/experiencias' : '/experiences'}/${x.slug}/` }));
const posts = (await getCollection('posts', (p) => p.data.lang === LANG))
  .filter((p) => p.data.hero)
  .sort((a, b) => (b.data.date || '').localeCompare(a.data.date || ''))
  .slice(0, 6);

const fmtDate = (iso: string) =>
  new Date(iso + 'T00:00:00').toLocaleDateString(L ? 'es-ES' : 'en-US', { day: 'numeric', month: 'short', year: 'numeric' });
const price = (x: any) => (x.publicPrice === 0 ? `<span class="free">${L ? 'Gratis' : 'Free'}</span>` : `${x.currency} ${x.publicPrice.toLocaleString()}`);

const t = {
  h1: L ? 'Viajes y Eventos Educativos para Líderes Globales' : 'Educational Trips & Events for Global Leaders',
  lead: L
    ? 'Experiencias internacionales de aprendizaje, eventos y viajes, para líderes de gobierno, empresa y sociedad civil. Organizadas por The New Global School y una red de aliados en Europa y América Latina.'
    : 'International learning experiences, events and journeys, for leaders in government, business and civil society. Hosted by The New Global School and a network of allies across Europe and Latin America.',
  explore: L ? 'Explorar experiencias' : 'Explore experiences',
  becomeAlly: L ? 'Únete como aliado' : 'Become an ally',
  programsEyebrow: L ? 'Programas' : 'Programs',
  programsTitle: L ? 'Eventos y Viajes' : 'Events & Trips',
  allEvents: L ? 'Todos' : 'All',
  events: L ? 'Eventos' : 'Events',
  trips: L ? 'Viajes' : 'Trips',
  allyEyebrow: L ? 'Para aliados' : 'For allies',
  allyTitle: L ? 'Lleva tus viajes y eventos a líderes de todo el mundo' : 'Bring your trips and events to leaders worldwide',
  allyLead: L
    ? 'Publica tus programas en nuestra plataforma, llega a una audiencia de líderes y déjanos la difusión, el registro y los pagos. Tú te enfocas en la experiencia.'
    : 'Publish your programs on our platform, reach an audience of leaders, and let us handle promotion, registration and payments. You focus on the experience.',
  allyPoints: L
    ? ['Vitrina indexable con tráfico y reputación ya establecidos', 'Registro y pagos gestionados (o cobras directo, tú eliges)', 'Certificación y respaldo de marca The New Global School']
    : ['Indexable storefront with established traffic and reputation', 'Managed registration and payments (or collect directly, your choice)', 'Certification and The New Global School brand backing'],
  votedEyebrow: L ? 'Lo más votado' : 'Most voted',
  votedTitle: L ? '¿Qué viaje te interesa más?' : 'Which trip interests you most?',
  votedIntro: L ? 'Vota por tu expedición favorita. Un voto por persona, así vemos qué viaje despierta más interés.' : 'Vote for your favourite expedition. One vote per person, so we can see which trip draws the most interest.',
  vote: L ? 'Votar' : 'Vote',
  voted: L ? 'Votado' : 'Voted',
  votesLabel: L ? 'votos' : 'votes',
  blogEyebrow: L ? 'Del blog' : 'From the blog',
  blogTitle: L ? 'Ideas y reflexiones' : 'Ideas & reflections',
  blogAll: L ? 'Ver todo el blog' : 'See the full blog',
  aboutEyebrow: L ? 'Quiénes somos' : 'About us',
  aboutTitle: L ? 'Más de una década formando líderes globales' : 'Over a decade shaping global leaders',
  aboutLead: L
    ? 'Desde 2010, The New Global School diseña experiencias educativas y eventos internacionales para líderes de gobierno, empresa y sociedad civil. Con base en Viena y presencia en América Latina, unimos rigor académico, inmersión cultural y una red global de aliados.'
    : 'Since 2010, The New Global School has designed educational experiences and international events for leaders in government, business and civil society. Based in Vienna and active across Latin America, we combine academic rigor, cultural immersion and a global network of partners.',
  aboutPillars: L
    ? [
        { title: 'Desde 2010', text: 'Más de una década de trayectoria formando a tomadores de decisión en Europa y América Latina.' },
        { title: 'Alcance internacional', text: 'Con base en Viena (Austria) y una red de aliados que conecta continentes, culturas e instituciones.' },
        { title: 'Rigor y reputación', text: 'Programas con certificaciones internacionales y participantes de universidades, gobiernos y organismos como Naciones Unidas.' },
      ]
    : [
        { title: 'Since 2010', text: 'More than a decade of experience training decision-makers across Europe and Latin America.' },
        { title: 'International reach', text: 'Based in Vienna, Austria, with a network of partners connecting continents, cultures and institutions.' },
        { title: 'Rigor and reputation', text: 'Programs with international certifications and participants from universities, governments and bodies such as the United Nations.' },
      ],
  testiEyebrow: L ? 'Testimonios' : 'Testimonials',
  testiTitle: L ? 'Lo que dicen nuestros participantes' : 'What our participants say',
};

const testimonials = (L
  ? [
      { headline: 'Inversión', quote: 'El programa está diseñado para saber liderar en las realidades de nuestros países. Es una mejor inversión que un máster en Europa.', author: 'Lorena Gómez', org: 'Máster por Brunel University London y Doctorado por la Universidad de Viena' },
      { headline: 'Excelente', quote: 'Es una excelente organización que brinda una gran oportunidad de vivir esta magnífica experiencia, adquirir conocimientos y nuevas amistades.', author: 'Marcela Mejía', org: 'Oficina de Naciones Unidas contra la Droga y el Delito, Colombia' },
      { headline: 'Contenidos', quote: 'Una gran experiencia. Grandes contenidos y ¡mejores personas!', author: 'Irma Murillo', org: 'Sistema Estatal Anticorrupción, México' },
      { headline: 'Fascinante', quote: 'Es fascinante la forma en que las herramientas ayudan a resolver problemas reales.', author: 'Billy Batware', org: 'Academia Regional de las Naciones Unidas' },
      { headline: 'Personas maravillosas', quote: 'Gracias por todas las herramientas y enseñanzas, un programa práctico donde conocí a personas maravillosas.', author: 'Natalia Lever', org: 'The Climate Reality Project Latin America' },
      { headline: 'Experiencia única', quote: '¡Una experiencia única! Las herramientas metodológicas y el material son de mucha utilidad.', author: 'Juliana Galindo', org: 'The Guernica Centre for International Justice' },
      { headline: 'Excelente', quote: '¡Excelente experiencia académica y cultural!', author: 'Karina Nuñez', org: "Orphan's Promise Latin America" },
      { headline: 'Única', quote: '¡Una experiencia de vida única!', author: 'Verónica Narvaez', org: 'Directora de Gestión Ambiental, Santo Domingo, Ecuador' },
    ]
  : [
      { headline: 'The best is the connection', quote: 'The best of this experience is not only to be around the coaches and mentors but the entrepreneurs who are here sharing their dreams.', author: 'Gabriel Ekman, Sweden', org: 'BAG Innovation' },
      { headline: 'Enlightening', quote: 'The experience has been very enlightening and inspirational, recommended for those who are willing to challenge the status quo.', author: 'Sebastian Baayel, Ghana', org: 'African Entrepreneurship and Innovation Centre' },
      { headline: 'Remarkable', quote: 'Thanks for all the tools, but above all for the remarkable change-makers who I can now call my friends.', author: 'Natalia Lever, Mexico', org: 'The Climate Reality Project Latam' },
      { headline: 'Well prepared', quote: 'Inspiring presentations, well prepared, insightful, interactive and easy to work with.', author: 'Liana Taylor, Germany', org: 'Hive Europe' },
    ]) as { headline: string; quote: string; author: string; org: string }[];

// Iconos SVG inline para los pilares de "Quiénes somos" (sin librerías, theme-able).
const ICONS: Record<string, string> = {
  clock: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
  globe: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.6 2.7 3.9 6 3.9 9s-1.3 6.3-3.9 9c-2.6-2.7-3.9-6-3.9-9s1.3-6.3 3.9-9Z"/></svg>',
  award: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="5"/><path d="M9 13.4 7.5 22 12 19.5 16.5 22 15 13.4"/></svg>',
};
const ABOUT_ICONS = ['clock', 'globe', 'award'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: BRAND,
  url: SELF_ORIGIN[LANG],
  description: t.lead,
  foundingDate: '2010',
  location: { '@type': 'Place', address: 'Vienna, Austria' },
};
---
<MarketplaceLayout title={`${BRAND}, ${t.h1}`} description={t.lead}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- HERO -->
  <section class="home-hero mkt-wrap">
    <p class="eyebrow">The New Global School</p>
    <h1>{t.h1}</h1>
    <p class="lead">{t.lead}</p>
    <div class="hero-cta">
      <a class="btn-primary" href="#programas">{t.explore}</a>
      <a class="btn-ghost" href={applyUrl}>{t.becomeAlly} →</a>
    </div>
  </section>

  <!-- MÁS VOTADOS (widget cliente, votos en vivo) -->
  {votingData.length > 0 && (
  <section class="mkt-wrap voted-sec" id="voted-section">
    <div class="sec-head"><p class="eyebrow">{t.votedEyebrow}</p><h2>{t.votedTitle}</h2></div>
    <p class="voted-intro">{t.votedIntro}</p>
    <div class="voted-grid" id="voted-grid"></div>
  </section>
  )}
  <script id="xp-vote-data" type="application/json" set:html={JSON.stringify(votingData)}></script>
  <script define:vars={{ voteTxt: t.vote, votedTxt: t.voted, votesTxt: t.votesLabel }}>
    (async () => {
      const el = document.getElementById('voted-grid');
      if (!el) return;
      const data = JSON.parse(document.getElementById('xp-vote-data').textContent || '[]');
      const bySlug = Object.fromEntries(data.map((d) => [d.slug, d]));
      let counts = {}, voted = [];
      try {
        const r = await fetch('/api/votes');
        const j = await r.json();
        counts = j.counts || {}; voted = j.voted || [];
      } catch (e) { /* sin conexión: mostrar en 0 */ }

      const render = () => {
        const items = data
          .map((d) => ({ ...d, votes: counts[d.slug] || 0, mine: voted.includes(d.slug) }))
          .sort((a, b) => b.votes - a.votes)
          .slice(0, 6);
        el.innerHTML = items.map((x) => `
          <div class="voted-card">
            <a href="${x.url}" class="vc-media"><img src="${x.cover}" alt="${x.title}" loading="lazy"></a>
            <div class="vc-body">
              <a href="${x.url}"><h3>${x.title}</h3></a>
              <div class="vc-foot">
                <span class="vc-count"><b>${x.votes}</b> ${votesTxt}</span>
                <button class="vc-btn" data-slug="${x.slug}" ${x.mine ? 'disabled' : ''}>${x.mine ? votedTxt + ' ✓' : voteTxt}</button>
              </div>
            </div>
          </div>`).join('');
        el.querySelectorAll('.vc-btn:not([disabled])').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const slug = btn.dataset.slug;
            btn.disabled = true;
            try {
              const r = await fetch('/api/votes', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ slug }) });
              const j = await r.json();
              if (j.votes != null) counts[slug] = j.votes;
              if (!voted.includes(slug)) voted.push(slug);
            } catch (e) {}
            render();
          });
        });
      };
      render();
    })();
  </script>

  <!-- PROGRAMAS (todas las experiencias, como en /experiences) -->
  <section class="mkt-wrap" id="programas">
    <div class="sec-head">
      <p class="eyebrow">{t.programsEyebrow}</p>
      <h2>{t.programsTitle}</h2>
    </div>
    {experiences.length === 0 ? (
      <div class="mkt-empty glass">
        <h3>{L ? 'Próximamente' : 'Coming soon'}</h3>
        <p set:html={L ? 'Estamos preparando más experiencias.' : 'We\'re preparing our international events and trips in English. Meanwhile, explore the <a href="/blog/">blog</a>.'} />
      </div>
    ) : (
    <>
    <div class="mkt-filters" id="filters">
      <button class="mkt-chip" data-f="all" aria-pressed="true">{t.allEvents}</button>
      <button class="mkt-chip" data-f="evento" aria-pressed="false">{t.events}</button>
      <button class="mkt-chip" data-f="viaje" aria-pressed="false">{t.trips}</button>
    </div>
    <div class="mkt-grid">
      {experiences.map((x) => (
        <a class="xp-card" href={`${xbase}/${x.slug}/`} data-type={x.type}>
          <div class="media">
            <img src={x.coverImageUrl} alt={x.title} width="400" height="250" loading="lazy" />
            <span class={`xp-badge ${x.type}`}>{x.type === 'evento' ? t.events.replace(/s$/, '') : (L ? 'Viaje' : 'Trip')}</span>
          </div>
          <div class="body">
            <div class="meta"><span>📍 {x.city}, {x.country}</span><span>·</span><span>🗓 {seasonsText(x, L)}</span></div>
            <h3>{x.title}</h3>
            <p class="summary">{x.summary}</p>
            <div class="foot"><span class="xp-price consult">{L ? 'A consultar' : 'On request'}</span><span class="xp-pub">{x.publisher?.type === 'tgs' ? 'TNGS' : x.publisher?.name}</span></div>
          </div>
        </a>
      ))}
    </div>
    </>
    )}
  </section>

  <!-- QUIÉNES SOMOS (autoridad) -->
  <section class="mkt-wrap about-sec" id="nosotros">
    <div class="sec-head"><p class="eyebrow">{t.aboutEyebrow}</p><h2>{t.aboutTitle}</h2></div>
    <p class="about-lead">{t.aboutLead}</p>
    <div class="about-pillars">
      {t.aboutPillars.map((p, i) => (
        <div class="about-card glass">
          <span class="about-icon" set:html={ICONS[ABOUT_ICONS[i]]} />
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- TESTIMONIOS -->
  <section class="mkt-wrap xp-testimonials" id="testimonios">
    <div class="sec-head"><p class="eyebrow">{t.testiEyebrow}</p><h2>{t.testiTitle}</h2></div>
    <div class="testi-grid">
      {testimonials.map((tt) => (
        <figure class="testi-card glass">
          <p class="testi-headline">{tt.headline}</p>
          <blockquote>{tt.quote}</blockquote>
          <figcaption>
            <div>
              <div class="testi-stars" aria-hidden="true">★★★★★</div>
              <strong>{tt.author}</strong>
              <span>{tt.org}</span>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- ALIADOS -->
  <section class="ally-band">
    <div class="mkt-wrap ally-inner">
      <div>
        <p class="eyebrow">{t.allyEyebrow}</p>
        <h2>{t.allyTitle}</h2>
        <p class="lead">{t.allyLead}</p>
        <ul class="ally-points">{t.allyPoints.map((p) => <li>{p}</li>)}</ul>
        <a class="btn-primary" href={applyUrl}>{t.becomeAlly}</a>
      </div>
    </div>
  </section>

  <!-- DEL BLOG (SEO + reputación) -->
  <section class="mkt-wrap" id="blog">
    <div class="sec-head">
      <p class="eyebrow">{t.blogEyebrow}</p>
      <h2>{t.blogTitle}</h2>
    </div>
    <div class="mkt-grid">
      {posts.map((p) => (
        <a class="xp-card" href={`/${p.data.slug}/`}>
          <div class="media"><img src={p.data.hero} alt={p.data.title} width="400" height="250" loading="lazy" /></div>
          <div class="body">
            <h3>{p.data.title}</h3>
            <p class="summary">{(p.data.description || '').slice(0, 120)}</p>
          </div>
        </a>
      ))}
    </div>
    <p style="text-align:center;margin-top:2rem"><a class="btn-ghost" href="/blog/">{t.blogAll} →</a></p>
  </section>

  <script>
    const chips = document.querySelectorAll('.mkt-chip');
    const cards = document.querySelectorAll<HTMLElement>('#programas .xp-card');
    const apply = (f: string) => {
      chips.forEach((c) => c.setAttribute('aria-pressed', String((c as HTMLElement).dataset.f === f)));
      cards.forEach((c) => (c.style.display = f === 'all' || c.dataset.type === f ? '' : 'none'));
    };
    chips.forEach((c) => c.addEventListener('click', () => apply((c as HTMLElement).dataset.f!)));
  </script>
</MarketplaceLayout>
