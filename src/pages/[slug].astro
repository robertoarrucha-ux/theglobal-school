---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import PageLayout from '../layouts/PageLayout.astro';
import PageDarkLayout from '../layouts/PageDarkLayout.astro';
import CourseLayout from '../layouts/CourseLayout.astro';
import InstitutionalLayout from '../layouts/InstitutionalLayout.astro';
import CategoryLayout from '../layouts/CategoryLayout.astro';
import { parseCourse } from '../lib/courses';
import { parseInstitutional } from '../lib/institutional';
import categoriesData from '../../migration/categories.json';
import pagesClassified from '../../migration/pages_classified.json';
import { LANG } from '../lib/site';

export async function getStaticPaths() {
  // Slugs que se redirigen (301) a un dominio externo vía firebase.json (gen_firebase.py):
  // no se construyen como página ni entran al sitemap. (getStaticPaths corre aislado: definir aquí.)
  const REDIRECTED_SLUGS = new Set([
    'latin-america-leaders-awards',
    'bienvenido-a-los-latin-american-leaders-awards',
    'equipo-latam-awards',
    'confirmacion-de-postulacion-latam-awards',
  ]);
  const posts = await getCollection('posts', (e) => e.data.lang === LANG);
  const pages = await getCollection('pages', (e) => e.data.lang === LANG);
  const projects = await getCollection('projects', (e) => e.data.lang === LANG);

  // Páginas que hablan de los Latin American Leaders Awards: se les añade la nota de atribución
  // (Pro-Latam organiza; TNGS aliado) para corregir la señal a Google. Detección por título.
  // Cubre variantes: "Latam Awards", singular "Award", y distinto orden de palabras.
  // NO matchea otros premios (African / Sustainability Leaders Awards).
  const isLala = (s: string) => {
    const x = (s || '').toLowerCase();
    if (/latam awards/.test(x)) return true;
    return /latin americ\w*/.test(x) && /leaders?/.test(x) && /awards?/.test(x);
  };
  const isAwardEntry = (e: any) => isLala(e.data.title) || isLala(e.data.seoTitle);

  // Detalles editoriales del blog: tiempo de lectura + artículos relacionados.
  const postBySlug = new Map(posts.map((p) => [p.data.slug, p.data]));
  const recentPosts = posts.map((p) => p.data).sort((a, b) => (b.date || '').localeCompare(a.date || ''));
  const catsForLang = (Object.values(categoriesData) as any[]).filter((c) => c.lang === LANG);
  const readMin = (entry: any) => Math.max(1, Math.round(String(entry.body || '').split(/\s+/).filter(Boolean).length / 200));
  const relatedFor = (slug: string) => {
    const sib = new Set<string>();
    for (const c of catsForLang) if (c.posts.includes(slug)) for (const s of c.posts) if (s !== slug) sib.add(s);
    const picks = [...sib].map((s) => postBySlug.get(s)).filter(Boolean) as any[];
    if (picks.length < 3) for (const p of recentPosts) { if (p.slug !== slug && !picks.includes(p)) { picks.push(p); if (picks.length >= 3) break; } }
    return picks.slice(0, 3).map((p) => ({ title: p.title, slug: p.slug, hero: p.hero, date: p.date }));
  };

  // mapa slug -> arquetipo (de la clasificación con tráfico GSC)
  const archOf = new Map<string, string>();
  for (const p of pagesClassified as any[]) {
    if (p.lang === LANG) archOf.set(p.slug, p.arch);
  }

  const seen = new Set<string>();
  const out: any[] = [];
  for (const entry of posts) {
    if (seen.has(entry.data.slug)) continue;
    seen.add(entry.data.slug);
    out.push({ params: { slug: entry.data.slug }, props: { entry, kind: 'posts', readingTime: readMin(entry), related: relatedFor(entry.data.slug), isAward: isAwardEntry(entry) } });
  }
  for (const entry of pages) {
    if (!entry.data.slug || seen.has(entry.data.slug)) continue;
    const arch = archOf.get(entry.data.slug) || 'Institucional';
    if (arch === 'Sistema') continue; // 404-2, duplicados de home, welcome -> se redirigen a home
    if (entry.data.slug === 'blog') continue; // /blog/ lo maneja el índice paginado
    if (REDIRECTED_SLUGS.has(entry.data.slug)) continue; // 301 a awards.pro-latam.org (ver gen_firebase.py)
    seen.add(entry.data.slug);
    out.push({ params: { slug: entry.data.slug }, props: { entry, kind: 'pages', archetype: arch, isAward: isAwardEntry(entry) } });
  }
  for (const entry of projects) {
    if (!entry.data.slug || seen.has(entry.data.slug)) continue;
    seen.add(entry.data.slug);
    out.push({ params: { slug: entry.data.slug }, props: { entry, kind: 'projects', archetype: 'Proyecto' } });
  }

  // páginas de categoría (root-level)
  for (const cat of Object.values(categoriesData as Record<string, any>)) {
    if (cat.lang !== LANG || seen.has(cat.slug)) continue;
    const items = cat.posts.map((s: string) => postBySlug.get(s)).filter(Boolean);
    if (!items.length) continue;
    seen.add(cat.slug);
    out.push({ params: { slug: cat.slug }, props: { kind: 'category', category: { ...cat, items } } });
  }
  return out;
}

const { entry, kind, category, archetype, readingTime, related, isAward } = Astro.props as any;
const rendered = kind === 'category' ? null : await render(entry);
const Content = rendered?.Content;
// Historias (long-form) y Legal siguen en tema claro; el resto de páginas landing van a la marca oscura.
const LIGHT_PAGE = new Set(['Historia', 'Legal']);
const usePageDark = kind !== 'posts' && kind !== 'category' && !LIGHT_PAGE.has(archetype);
// Cursos en línea: estructura propia (catálogo o landing de curso). Se detectan por arquetipo
// Programa/Curso, o por señales de contenido (título de curso / lista de módulos), porque muchas
// páginas de curso quedaron mal clasificadas como Perfil, Evento o Proyecto. Nunca posts (blog).
const COURSE_TITLE = /\b(cursos?|m[óo]dulos?|masterclass|diplomado|course|module)\b/i;
const COURSE_BODY = /\[\s*(m[óo]dulo|module)\s*\d|\[\s*descripci[óo]n\s*\]\(#\)/i;
const isCourse =
  kind !== 'posts' &&
  kind !== 'category' &&
  (archetype === 'Programa/Curso' ||
    COURSE_TITLE.test(entry?.data?.title || '') ||
    COURSE_BODY.test(entry?.body || ''));
const course = isCourse ? parseCourse(entry.body) : null;
// Páginas institucionales (nosotros, alianzas, about-us...) con equipo/temáticas: estructura propia.
const inst = !isCourse && kind === 'pages' && archetype === 'Institucional' ? parseInstitutional(entry.body) : null;
const useInst = inst?.hasStructured;
---
{kind === 'category' ? (
  <CategoryLayout category={category} />
) : kind === 'posts' ? (
  <ArticleLayout data={entry.data} readingTime={readingTime} related={related} isAward={isAward}><Content /></ArticleLayout>
) : isCourse ? (
  <CourseLayout data={entry.data} course={course}><Content /></CourseLayout>
) : useInst ? (
  <InstitutionalLayout data={entry.data} inst={inst} isAward={isAward} />
) : usePageDark ? (
  <PageDarkLayout data={entry.data} archetype={archetype} isAward={isAward}><Content /></PageDarkLayout>
) : (
  <PageLayout data={entry.data} archetype={archetype} isAward={isAward}><Content /></PageLayout>
)}
