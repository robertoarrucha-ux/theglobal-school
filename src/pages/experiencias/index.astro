---
import MarketplaceLayout from '../../layouts/MarketplaceLayout.astro';
import { loadExperiences } from '../../lib/experiences';
import { LANG } from '../../lib/site';

// M2 (muestra): en EN redirige a /experiences/. Datos reales vendrán de Firestore.
if (LANG === 'en') return Astro.redirect('/experiences/');

const experiences = await loadExperiences();
const fmtDate = (iso: string) =>
  new Date(iso + 'T00:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });
const price = (x: any) => (x.publicPrice === 0 ? '<span class="free">Gratis</span>' : `${x.currency} ${x.publicPrice.toLocaleString()}`);
---
<MarketplaceLayout title="Eventos y Viajes — The New Global School" description="Descubre eventos internacionales y viajes educativos de The New Global School y aliados.">
  <section class="mkt-wrap mkt-hero">
    <p class="eyebrow">Marketplace</p>
    <h1>Eventos y Viajes para Líderes Globales</h1>
    <p>Eventos internacionales y viajes educativos — organizados por The New Global School y aliados en Europa y América Latina.</p>
  </section>

  <div class="mkt-wrap">
    <div class="mkt-filters" id="filters">
      <button class="mkt-chip" data-f="all" aria-pressed="true">Todos</button>
      <button class="mkt-chip" data-f="evento" aria-pressed="false">Eventos</button>
      <button class="mkt-chip" data-f="viaje" aria-pressed="false">Viajes</button>
    </div>

    <div class="mkt-grid" id="grid">
      {experiences.map((x) => (
        <a class="xp-card" href={`/experiencias/${x.slug}/`} data-type={x.type}>
          <div class="media">
            <img src={x.coverImageUrl} alt={x.title} width="400" height="250" loading="lazy" />
            <span class={`xp-badge ${x.type}`}>{x.type === 'evento' ? 'Evento' : 'Viaje'}</span>
          </div>
          <div class="body">
            <div class="meta">
              <span>📍 {x.city}, {x.country}</span><span>·</span><span>🗓 {fmtDate(x.startDate)}</span>
            </div>
            <h3>{x.title}</h3>
            <p class="summary">{x.summary}</p>
            <div class="foot">
              <span class="xp-price" set:html={price(x)} />
              <span class="xp-pub">{x.publisher.type === 'tgs' ? 'TNGS' : x.publisher.name}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>

  <script>
    const chips = document.querySelectorAll('.mkt-chip');
    const cards = document.querySelectorAll<HTMLElement>('.xp-card');
    const apply = (f: string) => {
      chips.forEach((c) => c.setAttribute('aria-pressed', String((c as HTMLElement).dataset.f === f)));
      cards.forEach((c) => (c.style.display = f === 'all' || c.dataset.type === f ? '' : 'none'));
    };
    chips.forEach((c) => c.addEventListener('click', () => apply((c as HTMLElement).dataset.f!)));
    const t = new URLSearchParams(location.search).get('t');
    if (t) apply(t);
  </script>
</MarketplaceLayout>
