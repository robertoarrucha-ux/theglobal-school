---
import MarketplaceLayout from '../../layouts/MarketplaceLayout.astro';
import { getEntry, render } from 'astro:content';
import { marked } from 'marked';
import { loadExperiences } from '../../lib/experiences';
import { LANG, SELF_ORIGIN } from '../../lib/site';
import { getInclusions } from '../../lib/inclusions';
import { seasonsText, editionRows } from '../../lib/editions';
import { youtubeId } from '../../lib/video';
const inc = getInclusions('es');

export async function getStaticPaths() {
  if (LANG === 'en') return []; // EN vive en /experiences/
  return (await loadExperiences()).map((x) => ({ params: { slug: x.slug }, props: { x } }));
}

const { x } = Astro.props as any;
const fmt = (iso: string) => new Date(iso + 'T00:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
const dateStr = x.endDate ? `${fmt(x.startDate)} – ${fmt(x.endDate)}` : fmt(x.startDate);

// "Tu experiencia completa": viaje usa las listas del programa o el default estándar;
// evento solo muestra lo que el aliado haya llenado (sin default de viaje).
const inclInc = x.included?.length ? x.included : (x.type === 'viaje' ? inc.included : []);
const inclNot = x.notIncluded?.length ? x.notIncluded : (x.type === 'viaje' ? inc.notIncluded : []);
const showIncl = inclInc.length > 0 || inclNot.length > 0;
const fmtFormat = (f: string) => (({ presencial: 'Presencial', online: 'Online', hibrido: 'Híbrido' } as Record<string, string>)[f] || 'Presencial');

// B2B: sin precios ni pago. CTA = contacto por WhatsApp para organizar el viaje.
const WHATSAPP = `https://api.whatsapp.com/send/?phone=4367761735010&text=${encodeURIComponent('Quiero organizar un viaje The New Global School')}`;
const ctaUrl = x.registerUrl || WHATSAPP;
const ctaLabel = x.registerUrl ? 'Más información' : 'Contáctanos para organizar tu viaje';
const isWa = !x.registerUrl;
const WA_ICON = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.004c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.02h-.003a8.23 8.23 0 0 1-4.19-1.15l-.3-.18-3.11.82.83-3.03-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.8-.79.97-.14.16-.29.18-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43l-.48-.01c-.16 0-.43.06-.65.31-.22.25-.85.83-.85 2.03 0 1.2.87 2.35.99 2.51.12.16 1.71 2.61 4.15 3.66.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29Z"/></svg>';
// Video por defecto para programas de TNGS (si la experiencia no trae su propio video).
const DEFAULT_TGS_VIDEO = 'https://www.youtube.com/watch?v=x_u3hDVb95o';
const ytId = youtubeId(x.videoUrl || (x.publisher?.type === 'tgs' ? DEFAULT_TGS_VIDEO : ''));
// Google exige uploadDate en VideoObject. Fechas reales de subida de nuestros videos.
// Si un video no tiene fecha conocida (ni x.videoUploadDate), NO emitimos el JSON-LD:
// mejor sin structured data que con un campo obligatorio faltante.
const VIDEO_UPLOAD_DATES: Record<string, string> = { x_u3hDVb95o: '2021-02-23', Ts5f7VJccmk: '2021-03-16' };
const videoUploadDate = x.videoUploadDate || (ytId ? VIDEO_UPLOAD_DATES[ytId] : '') || '';
const videoLd = ytId && videoUploadDate ? { '@context': 'https://schema.org', '@type': 'VideoObject', name: x.title, description: x.summary || x.title, thumbnailUrl: [`https://i.ytimg.com/vi/${ytId}/hqdefault.jpg`], uploadDate: videoUploadDate, embedUrl: `https://www.youtube.com/embed/${ytId}`, contentUrl: `https://www.youtube.com/watch?v=${ytId}` } : null;

// Contenido completo migrado (eventos TNGS con página original: LALA, Mujeres, Diplomado...).
const contentPage = await getEntry('pages', `es/page/${x.slug}`).catch(() => null);
const rendered = contentPage ? await render(contentPage) : null;
const FullContent = rendered?.Content;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': x.type === 'evento' ? 'Event' : 'TouristTrip',
  name: x.title,
  description: x.summary || x.title,
  startDate: x.startDate,
  ...(x.endDate ? { endDate: x.endDate } : {}),
  image: new URL(x.coverImageUrl, Astro.site).href,
  inLanguage: 'es',
  ...(x.type === 'evento'
    ? {
        eventAttendanceMode: x.format === 'online' ? 'https://schema.org/OnlineEventAttendanceMode' : 'https://schema.org/OfflineEventAttendanceMode',
        location: x.format === 'online' ? { '@type': 'VirtualLocation', url: SELF_ORIGIN[LANG] } : { '@type': 'Place', name: x.venue, address: `${x.city}, ${x.country}` },
        // offers solo si hay precio público real; el modelo B2B usa "A consultar" y no publica precios.
        ...(x.publicPrice > 0
          ? {
              offers: {
                '@type': 'Offer',
                price: x.publicPrice,
                priceCurrency: x.currency || 'EUR',
                url: new URL(Astro.url.pathname, Astro.site).href,
                availability: 'https://schema.org/InStock',
              },
            }
          : {}),
      }
    : {}),
  organizer: { '@type': 'Organization', name: 'The New Global School' },
};
---
<MarketplaceLayout title={`${x.title}, The New Global School`} description={x.summary} ogImage={x.coverImageUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {videoLd && <script type="application/ld+json" set:html={JSON.stringify(videoLd)} />}

  <section class="xp-detail-hero">
    <img src={x.coverImageUrl} alt={x.title} />
    <div class="mkt-wrap inner">
      <span class={`xp-badge ${x.type}`}>{x.type === 'evento' ? 'Evento' : 'Viaje'}</span>
      <h1 data-fresh="title" style="font-size:clamp(2.2rem,5vw,3.6rem);margin:.6rem 0">{x.title}</h1>
      <p data-fresh="summary" style="color:var(--txt-soft);max-width:640px">{x.summary}</p>
      <p data-fresh="meta" style="color:var(--txt-soft);font-size:.9rem;margin-top:1rem">📍 {x.venue ? x.venue + ' · ' : ''}{x.city}, {x.country} &nbsp;·&nbsp; 🗓 {seasonsText(x, true)} &nbsp;·&nbsp; 🗣 {x.language}</p>
    </div>
  </section>

  {ytId && (
    <section class="mkt-wrap xp-video">
      <div class="lite-yt" data-id={ytId}>
        <img src={`https://i.ytimg.com/vi/${ytId}/hqdefault.jpg`} alt={x.title} loading="lazy" width="1280" height="720" />
        <button class="lite-yt-play" type="button" aria-label="Reproducir video">
          <svg viewBox="0 0 68 48" aria-hidden="true"><path class="yt-bg" d="M66.5 7.7c-.8-2.9-3-5.1-5.9-5.9C55.3.5 34 .5 34 .5S12.7.5 7.4 1.8C4.5 2.6 2.3 4.8 1.5 7.7.2 13 .2 24 .2 24s0 11 1.3 16.3c.8 2.9 3 5.1 5.9 5.9C12.7 47.5 34 47.5 34 47.5s21.3 0 26.6-1.3c2.9-.8 5.1-3 5.9-5.9C67.8 35 67.8 24 67.8 24s0-11-1.3-16.3z"/><path d="M27 34l18-10-18-10z" fill="#fff"/></svg>
        </button>
      </div>
    </section>
  )}

  <section class="mkt-wrap xp-gallery" data-fresh="gallery" hidden={!(x.eventGallery && x.eventGallery.length > 0)}>
    {x.eventGallery && x.eventGallery.length > 0 && (
      <div class="gallery-strip" data-autoplay>
        {x.eventGallery.map((g: any, i: number) => (
          <figure class="gslide"><img src={g.imageUrl} alt={g.caption || x.title} loading={i === 0 ? 'eager' : 'lazy'} width="1000" height="560" /></figure>
        ))}
      </div>
    )}
  </section>

  <div class="mkt-wrap xp-detail-grid">
    <div>
      {x.type === 'viaje' && (
        <div class="xp-vote glass" data-slug={x.slug}>
          <div class="xp-vote-info">
            <strong>Vota por tu viaje favorito</strong>
            <span><b class="xp-vote-count">·</b> votos</span>
          </div>
          <button class="xp-vote-btn" type="button">Votar</button>
        </div>
      )}

      {x.cities && x.cities.length > 0 && (
        <div class="xp-route" aria-label="Ruta del viaje">
          {x.cities.map((c: string, i: number) => (
            <>
              <span class="city">{c}</span>
              {i < x.cities.length - 1 && <span class="arrow" aria-hidden="true">→</span>}
            </>
          ))}
        </div>
      )}

      <div class="xp-accordions" data-fresh="sections" hidden={!(x.sections && x.sections.length > 0)}>
        {x.sections && x.sections.length > 0 && (
          <>
            {x.description && <p class="xp-lead">{x.description}</p>}
            {x.sections.map((s: any, i: number) => (
              <details class="acc" open={i === 0}>
                <summary>{s.title}<span class="acc-icon" aria-hidden="true"></span></summary>
                <div class="acc-body xp-richbody" set:html={marked.parse(s.md, { breaks: true })} />
              </details>
            ))}
          </>
        )}
      </div>
      {!(x.sections && x.sections.length > 0) && (
        <div data-fresh-fallback>
          {FullContent
            ? <div class="xp-richbody"><FullContent /></div>
            : (!x.leader && !x.rationale && x.description
                ? <div class="xp-richbody"><h2>Acerca de</h2><Fragment set:html={marked.parse(x.description, { breaks: true })} /></div>
                : null)}
        </div>
      )}

      {x.leader && (
        <figure class="xp-leader glass">
          <p class="xp-leader-label">🏛️ Tu guía histórico</p>
          <blockquote>{x.leader.narrative}</blockquote>
          <figcaption>{x.leader.name} · <span>{x.leader.title}</span></figcaption>
        </figure>
      )}

      <section class="xp-collabs" data-fresh="collaborators" hidden={!(x.collaborators && x.collaborators.length > 0)}>
        {x.collaborators && x.collaborators.length > 0 && (
          <>
            <h2>Colaboradores y Expositores</h2>
            <div class="collab-grid">
              {x.collaborators.map((c: any) => (
                <figure class="collab-tile" title={c.name || ''}>
                  <img src={c.imageUrl} alt={c.name || 'Colaborador'} loading="lazy" />
                  {c.name && <figcaption>{c.name}</figcaption>}
                </figure>
              ))}
            </div>
          </>
        )}
      </section>

      <section class="xp-testimonials" data-fresh="testimonials" hidden={!(x.testimonials && x.testimonials.length > 0)}>
        {x.testimonials && x.testimonials.length > 0 && (
          <>
            <h2>Lo que dicen los participantes</h2>
            <div class="testi-grid">
              {x.testimonials.map((t: any) => (
                <figure class="testi-card glass">
                  {t.headline && <p class="testi-headline">{t.headline}</p>}
                  <blockquote>{t.quote}</blockquote>
                  <figcaption>
                    {t.photo && <img class="testi-avatar" src={t.photo} alt={t.author} loading="lazy" width="46" height="46" />}
                    <div>
                      <strong>{t.author}</strong>
                      {t.org && (t.orgUrl
                        ? <a href={t.orgUrl} target="_blank" rel="noopener">{t.org}</a>
                        : <span>{t.org}</span>)}
                    </div>
                  </figcaption>
                </figure>
              ))}
            </div>
          </>
        )}
      </section>

      {x.rationale && (
        <>
          <h2>🎯 ¿Por qué este viaje?</h2>
          <div class="xp-rationale">
            <div class="glass"><h4>Importancia</h4><p>{x.rationale.importance}</p></div>
            <div class="glass"><h4>Aprendizaje</h4><p>{x.rationale.learning}</p></div>
            <div class="glass"><h4>Relevancia profesional</h4><p>{x.rationale.relevance}</p></div>
          </div>
        </>
      )}

      <h2>✨ Destacados</h2>
      <ul class="xp-highlights" data-fresh="highlights">{x.highlights.map((h: string) => <li>{h}</li>)}</ul>

      {x.itinerary && x.itinerary.length > 0 ? (
        <>
          <h2>🗺️ Itinerario detallado</h2>
          <div class="xp-agenda">
            {x.itinerary.map((d: any) => (
              <div class="xp-agenda-item glass">
                <div class="lbl">Día {d.day}</div>
                <strong>{d.title}</strong>
                <p style="margin:.3rem 0 0">{d.description}</p>
                {d.relevance && <p class="rel">↳ {d.relevance}</p>}
              </div>
            ))}
          </div>
        </>
      ) : x.agenda && (
        <>
          <h2>{x.type === 'evento' ? '📅 Agenda' : '🗺️ Itinerario'}</h2>
          <div class="xp-agenda">
            {x.agenda.map((a: any) => (
              <div class="xp-agenda-item glass">
                <div class="lbl">{a.label}</div>
                <strong>{a.title}</strong>
                <p style="margin:.3rem 0 0">{a.detail}</p>
              </div>
            ))}
          </div>
        </>
      )}

      {x.preWork && x.preWork.items?.length > 0 && (
        <>
          <h2>📚 {x.preWork.title || 'Preparación: materiales recomendados'}</h2>
          <ul class="xp-prework">
            {x.preWork.items.map((it: any) => (
              <li><span class="tag">{it.type}</span> <strong>{it.title}</strong>{it.author ? `, ${it.author}` : ''}</li>
            ))}
          </ul>
        </>
      )}

      <section class="xp-incl-wrap" data-fresh="inclusions" hidden={!showIncl}>
        {showIncl && (
          <>
            <h2>Tu experiencia completa</h2>
            <div class="xp-incl">
              {inclInc.length > 0 && <div><h4 class="ok">✓ Qué incluye</h4><ul>{inclInc.map((i: string) => <li>{i}</li>)}</ul></div>}
              {inclNot.length > 0 && <div><h4 class="no">✕ Qué no incluye</h4><ul>{inclNot.map((i: string) => <li>{i}</li>)}</ul></div>}
            </div>
          </>
        )}
      </section>

      <section class="xp-how">
        <h2>🧭 ¿Cómo funciona?</h2>
        <div class="xp-how-steps">
          <div class="xp-how-step glass"><span class="num">1</span><h4>Cuéntanos tu objetivo</h4><p>Escríbenos con tu organización, el tema de interés y las fechas aproximadas.</p></div>
          <div class="xp-how-step glass"><span class="num">2</span><h4>Lo diseñamos a tu medida</h4><p>Adaptamos itinerario, ciudades, idioma y tamaño de grupo. Grupos privados disponibles.</p></div>
          <div class="xp-how-step glass"><span class="num">3</span><h4>Confirmamos y viajan</h4><p>Cerramos logística, certificados y materiales; tu equipo vive la experiencia.</p></div>
        </div>
        <a class="btn-primary xp-how-cta" href={ctaUrl} target="_blank" rel="noopener">{isWa && <Fragment set:html={WA_ICON} />}{ctaLabel}</a>
      </section>
    </div>

    <aside>
      <div class="xp-book glass">
        <div style="margin:0 0 1rem">
          {editionRows(x, true).length > 0
            ? editionRows(x, true).map((e) => <div class="row"><span>{e.label}</span><span>{e.range}</span></div>)
            : <div class="row"><span>Fechas</span><span>{dateStr}</span></div>}
          <div class="row"><span>Formato</span><span>{fmtFormat(x.format)}</span></div>
          <div class="row"><span>Anfitrión</span><span>{x.publisher.type === 'tgs' ? 'TNGS' : x.publisher.name}</span></div>
        </div>
        <a class="xp-cta" href={ctaUrl} target="_blank" rel="noopener">
          {isWa && <Fragment set:html={WA_ICON} />}
          {ctaLabel}
        </a>
        <p class="pay-note">Adaptamos itinerario, fechas, idioma y tamaño de grupo. Grupos privados para tu organización. Te respondemos en 24 h.</p>
      </div>
    </aside>
  </div>
</MarketplaceLayout>
