# Acumbamail SMTP (mismas keys que otros proyectos Pro-Latam)
# Se cargan como secrets en la Cloud Function (no en el repo):
#   firebase functions:secrets:set SMTP_USER --project gen-lang-client-0345505794
#   firebase functions:secrets:set SMTP_PASS --project gen-lang-client-0345505794
SMTP_HOST=smtp.acumbamail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="hello@theglobal.school"
SMTP_FROM_NAME="The New Global School"
